{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Web",
      "skipFiles": ["<node_internals>/**"],
      "program": "${workspaceFolder}/apps/web/node_modules/.bin/next",
      "args": ["dev"]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug API",
      "skipFiles": ["<node_internals>/**"],
      "program": "${workspaceFolder}/apps/api/src/index.ts",
      "runtimeArgs": ["-r", "ts-node/register"]
    }
  ]
}
